{
  "expo": {
    "name": "Mini GnuCash",
    "slug": "mini-gnucash",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "minignucash",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.forstradigital.minignucash"
    },
    "android": {
      "package": "com.forstradigital.minignucash",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mini GnuCash to access your photos to scan receipts.",
          "cameraPermission": "Allow Mini GnuCash to use your camera to scan receipts."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "./plugins/withGradleJvmMemory",
      "./plugins/withReleaseSigningConfig",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#14140f"
        }
      ],
      "expo-font",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

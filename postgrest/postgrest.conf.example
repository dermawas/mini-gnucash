# PostgREST config template for mini-gnucash.
#
# Copy this to /etc/postgrest/postgrest.conf (or wherever you keep it) and
# fill in the placeholders. See README.md, step 5, for the walkthrough this
# belongs to.

# Connection string for the `authenticator_mgc` role created by
# sql/10_roles_and_grants.sql. This is the ONLY role PostgREST itself
# connects as — it then impersonates whichever role a request's JWT
# names in its `role` claim (gnucash_mgc_user, per that same file).
# The password must be percent-encoded if it contains special characters.
db-uri = "postgres://authenticator_mgc:CHANGE_ME_authenticator_password@localhost:5432/CHANGE_ME_your_gnucash_database"

# GnuCash's tables all live in the public schema.
db-schema = "public"

# Must exactly match the secret you pass to scripts/make_jwt.py when
# generating your token. Generate one with: openssl rand -base64 32
jwt-secret = "CHANGE_ME_generate_with_openssl_rand_-base64_32"

# No db-anon-role is set on purpose — every request MUST carry a valid
# JWT. Do not add a db-anon-role line unless you specifically want
# unauthenticated access to work (you don't, for this use case).

# Bind address/port. A VPN-interface address (e.g. a WireGuard 10.x.x.x)
# is a WireGuard VPN interface IP — PostgREST is only reachable over the
# VPN, not the public internet, which was a deliberate choice during
# development. Recommended for most self-hosters too: either bind to a
# VPN-only interface like this, or bind to 127.0.0.1 and put a reverse
# proxy (with TLS) in front if you need to reach it without a VPN. Avoid
# binding directly to a public interface without HTTPS in front of it —
# your JWT is a bearer credential, and PostgREST itself only speaks
# plain HTTP.
server-host = "CHANGE_ME_your_bind_address"
server-port = 3000
